{
  "name": "@zombie-killer/desktop",
  "version": "0.1.0-alpha.1",
  "description": "Zombie Killer local-first Agentic AI containment console",
  "private": true,
  "license": "Apache-2.0",
  "author": {
    "name": "PhantomBugz",
    "url": "https://PhantomBugz.com"
  },
  "homepage": "https://github.com/PhantomBugz/Zombie-Killer-AI#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PhantomBugz/Zombie-Killer-AI.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-no-remote-assets.mjs",
    "native:prepare": "pnpm build && uv run --project ../.. --frozen python -I ../../scripts/build-engine-sidecar.py",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@babel/core": "8.0.1",
    "@babel/eslint-parser": "8.0.1",
    "@babel/plugin-syntax-jsx": "8.0.1",
    "@babel/plugin-syntax-typescript": "8.0.3",
    "@eslint/js": "10.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "axe-core": "4.13.0",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
